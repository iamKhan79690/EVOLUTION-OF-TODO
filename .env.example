# =============================================================================
# EVOLUTION-OF-TODO - Phase II Environment Configuration Template
# =============================================================================

# Database Configuration
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/dbname?sslmode=require

# Authentication Configuration
# Better Auth secret key (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production-32-characters

# Frontend Configuration
# Next.js application URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Better Auth routing
BETTER_AUTH_SIGN_IN_URL=/sign-in
BETTER_AUTH_SIGN_OUT_URL=/

# Backend API Configuration
# Backend API URL (for frontend consumption)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend server configuration
HOST=0.0.0.0
PORT=8000

# Development Settings
DEBUG=true
ENVIRONMENT=development

# Security Settings
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Optional: External Services (uncomment if needed)
# REDIS_URL=redis://localhost:6379
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password